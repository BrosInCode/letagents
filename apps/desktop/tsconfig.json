{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": { "vue": ["./node_modules/vue"] }
  },
  "include": [
    "demos/board/**/*.ts",
    "demos/board/**/*.vue",
    "renderer/src/**/*.ts",
    "renderer/src/**/*.d.ts",
    "renderer/src/**/*.tsx",
    "renderer/src/**/*.vue",
    "vite.config.ts"
  ]
}
