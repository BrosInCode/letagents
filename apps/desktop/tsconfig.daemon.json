{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist-daemon",
    "rootDir": "daemon"
  },
  "include": ["daemon/**/*.ts"],
  "exclude": ["daemon/**/__tests__/**"]
}
