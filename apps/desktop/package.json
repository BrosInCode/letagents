{
  "name": "letagents-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:watch:electron\" \"npm:serve:electron\"",
    "dev:renderer": "vite",
    "watch:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "serve:electron": "wait-on tcp:5174 dist-electron/main.js && cross-env LETAGENTS_DESKTOP_DEV_SERVER_URL=http://127.0.0.1:5174 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "smoke:electron": "npm run build && cross-env LETAGENTS_DESKTOP_SMOKE_CHECK=1 electron .",
    "test": "npm run test:renderer && npm run test:electron",
    "test:renderer": "node --import tsx --test renderer/__tests__/*.test.ts",
    "test:electron": "node --import tsx --test electron/__tests__/*.test.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.196",
    "@lucide/vue": "^1.17.0",
    "@openai/agents": "^0.11.6",
    "@openai/agents-extensions": "^0.11.6",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "ai": "^6.0.207",
    "vue": "^3.5.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.3"
  }
}
