{
  "name": "letagents-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "letagentsRuntime": {
    "openCodeVersion": "1.18.9"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:watch:electron\" \"npm:watch:daemon\" \"npm:serve:electron\"",
    "dev:renderer": "vite",
    "watch:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "watch:daemon": "tsc -p tsconfig.daemon.json --watch --preserveWatchOutput",
    "serve:electron": "wait-on tcp:5174 dist-electron/main.js && cross-env LETAGENTS_DESKTOP_DEV_SERVER_URL=http://127.0.0.1:5174 electron .",
    "build": "npm run build:renderer && npm run build:electron && npm run build:daemon",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:daemon": "tsc -p tsconfig.daemon.json",
    "package:artifact": "npm run build && node electron/scripts/package-artifact.mjs",
    "smoke:electron": "npm run build && cross-env LETAGENTS_DESKTOP_SMOKE_CHECK=1 electron .",
    "screenshot:agent-detail": "npm run build && cross-env LETAGENTS_DESKTOP_SMOKE_CHECK=1 LETAGENTS_DESKTOP_AGENT_DETAIL_SCREENSHOT=/tmp/letagents-agent-detail-responsive.png electron .",
    "smoke:packaged-supervisor": "npm run package:artifact && node electron/scripts/packaged-supervisor-smoke.mjs",
    "smoke:cursor-managed": "node --import tsx electron/scripts/cursor-managed-isolation-smoke.ts",
    "smoke:opencode-contract": "npm run build:electron && node electron/scripts/opencode-runtime-contract-smoke.mjs",
    "smoke:claude-daemon-inbox": "node --import tsx electron/scripts/claude-daemon-inbox-spike.ts",
    "test": "npm run test:renderer && npm run test:electron && npm run test:daemon",
    "test:renderer": "node --import tsx --test renderer/__tests__/*.test.ts",
    "test:electron": "node --import tsx --test --experimental-test-module-mocks electron/__tests__/*.test.ts",
    "test:daemon": "node --import tsx --test daemon/__tests__/*.test.ts",
    "lint:vue-components": "eslint \"renderer/src/**/*.vue\"",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.daemon.json --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "1.17.0",
    "@openai/agents": "0.11.6",
    "@openai/agents-extensions": "0.11.6",
    "@openrouter/ai-sdk-provider": "2.9.1",
    "ai": "6.0.207",
    "cuelume": "0.1.0",
    "undici": "7.28.0",
    "vue": "3.5.33",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-vue": "5.2.4",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "42.4.0",
    "eslint": "10.6.0",
    "eslint-plugin-vue": "10.9.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vue-tsc": "2.2.12",
    "wait-on": "8.0.5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.19",
    "@hono/node-server": "2.0.10"
  }
}
