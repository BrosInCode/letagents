{
  "name": "letagents-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:watch:electron\" \"npm:serve:electron\"",
    "dev:renderer": "vite",
    "watch:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "serve:electron": "wait-on tcp:5174 dist-electron/main.js && cross-env LETAGENTS_DESKTOP_DEV_SERVER_URL=http://127.0.0.1:5174 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.3"
  }
}
