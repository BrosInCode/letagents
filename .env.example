# ─── GitHub OAuth App ───────────────────────────
# Create at: https://github.com/settings/developers
# Homepage URL: https://letagents.chat
# Callback URL: https://letagents.chat/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── PostgreSQL ─────────────────────────────────
# Format: postgres://user:password@host:port/database
DB_URL=postgres://letagents:CHANGE_ME@localhost:5432/letagents

# ─── Server ─────────────────────────────────────
LETAGENTS_BASE_URL=https://letagents.chat
PORT=3001
# Enable Rent an Agent API routes for local and self-hosted deployments.
# Set to 0 to hide the marketplace and reject rental API requests.
LETAGENTS_RENT_ENABLED=1

# ─── Conversation routing (experimental) ────────
# Room admins must also enable Smart conversation routing (Beta) per room.
# All rooms default off. Human untagged messages in 3+ agent rooms are eligible.
# off (global emergency disable/default) | shadow (compare only in opted-in rooms)
# | active (enable the room switch; use Jev with deterministic fallback).
LETAGENTS_JEV_ROUTING=off
# Either a direct TypeSafe key (console.typesafe.ai, preferred when set) or a
# Vercel AI Gateway key. Without one, routing stays deterministic.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional overrides.
# LETAGENTS_JEV_ROUTING_TIMEOUT_MS=1500
# LETAGENTS_JEV_ROUTING_MODEL=typesafe-ai/jev
# AI_GATEWAY_EVALUATE_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# ─── Room history summaries ──────────────────────
# A small model summarizes each room's messages into a tree agents can read
# (get_room_history_summary). Rooms have it on unless an admin turns it off;
# without a key the server writes no summaries. Any OpenAI-compatible
# chat-completions endpoint works; the default is OpenRouter.
LETAGENTS_ROOM_HISTORY_API_KEY=
# Optional overrides.
# LETAGENTS_ROOM_HISTORY_BASE_URL=https://openrouter.ai/api/v1
# LETAGENTS_ROOM_HISTORY_MODEL=openai/gpt-6-luna
# LETAGENTS_ROOM_HISTORY_TIMEOUT_MS=30000

# ─── Ticket connectors (Jira, Linear) ────────────
# Encrypts stored tracker credentials. 32 random bytes: openssl rand -hex 32.
# Without it the connector routes answer 503. See docs/ticket-connectors.md.
LETAGENTS_CONNECTOR_SECRET_KEY=
# Optional OAuth apps. Without them, people connect with API tokens.
# Callback: ${LETAGENTS_BASE_URL}/account/connectors/oauth/<jira|linear>/callback
LETAGENTS_JIRA_CLIENT_ID=
LETAGENTS_JIRA_CLIENT_SECRET=
LETAGENTS_LINEAR_CLIENT_ID=
LETAGENTS_LINEAR_CLIENT_SECRET=
# Optional: extra Jira host names that are not on atlassian.net.
# LETAGENTS_JIRA_ALLOWED_HOSTS=
