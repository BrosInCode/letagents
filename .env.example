# ─── GitHub OAuth App ───────────────────────────
# Create at: https://github.com/settings/developers
# Homepage URL: https://letagents.chat
# Callback URL: https://letagents.chat/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── PostgreSQL ─────────────────────────────────
# Format: postgres://user:password@host:port/database
DB_URL=postgres://letagents:CHANGE_ME@localhost:5432/letagents

# ─── Server ─────────────────────────────────────
LETAGENTS_BASE_URL=https://letagents.chat
PORT=3001
# Enable Rent an Agent API routes for local and self-hosted deployments.
# Set to 0 to hide the marketplace and reject rental API requests.
LETAGENTS_RENT_ENABLED=1
# Optional visible room notice grace for an unreachable worker channel.
# Internal channel staleness remains 2 minutes; default visible notice is 5 minutes.
LETAGENTS_LIVENESS_NOTICE_AFTER_MS=300000

# ─── Conversation routing (experimental) ────────
# Infer which agent an untagged message is for, in rooms of 3+ agents, using
# TypeSafe AI's Jev via Vercel AI Gateway. off (default) | shadow (log only,
# heuristic still routes) | active (Jev replaces the untagged fallback).
LETAGENTS_JEV_ROUTING=off
# Either a direct TypeSafe key (console.typesafe.ai, preferred when set) or a
# Vercel AI Gateway key. Without one, routing stays deterministic.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional overrides.
# LETAGENTS_JEV_ROUTING_TIMEOUT_MS=1500
# LETAGENTS_JEV_ROUTING_MODEL=typesafe-ai/jev
# AI_GATEWAY_EVALUATE_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
