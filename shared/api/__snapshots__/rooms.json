{
  "rooms.get": {
    "kind": "read",
    "capability": "rooms.read",
    "httpMethod": "GET",
    "path": "/rooms/:room",
    "response": "json",
    "rateClass": "read",
    "errors": [
      "not_found"
    ],
    "input": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "main",
            "focus"
          ]
        },
        "parentRoomId": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "github"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "fullName": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "ref": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "default_branch",
                            "branch",
                            "tag",
                            "pull_request"
                          ]
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "provider",
                "host",
                "owner",
                "name",
                "fullName",
                "url",
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "members",
            "public",
            "private",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "parentRoomId",
        "repo",
        "visibility"
      ],
      "additionalProperties": false
    }
  }
}
