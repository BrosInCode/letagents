{
  "data.delete": {
    "kind": "write",
    "capability": "data.page",
    "httpMethod": "DELETE",
    "path": "/rooms/:room/data/:scope/:collection/:docId",
    "response": "json",
    "rateClass": "write",
    "agents": "write",
    "errors": [
      "conflict"
    ],
    "input": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "viewer",
            "page",
            "room"
          ]
        },
        "collection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "docId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "pageId": {
          "description": "The page whose data this is, for the viewer and page scopes. A page leaves it out (its own id is used); a person or agent calling directly must give it. Not used in the room scope.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "ifRevision": {
          "description": "Compare-and-set: delete only when the document's revision is this number. Otherwise the call fails with conflict.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "string",
              "pattern": "^-?\\d{1,15}$"
            }
          ]
        }
      },
      "required": [
        "scope",
        "collection",
        "docId"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "deleted"
      ],
      "additionalProperties": false
    }
  },
